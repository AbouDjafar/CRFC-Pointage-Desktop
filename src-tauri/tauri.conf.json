{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRFC Pointage Desktop",
  "version": "0.1.0",
  "identifier": "cm.crfc.pointage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CRFC Pointage Desktop",
        "width": 1440,
        "height": 920,
        "visible": false,
        "resizable": true
      },
      {
        "label": "splashscreen",
        "title": "Chargement",
        "url": "splashscreen.html",
        "width": 520,
        "height": 420,
        "visible": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "CRFC",
    "copyright": "Copyright (c) 2026 CRFC. Tous droits reserves.",
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./sign-windows.ps1 %1"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "CRFC Pointage Desktop"
  }
}
