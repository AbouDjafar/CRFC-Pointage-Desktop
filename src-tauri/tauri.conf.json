{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRFC Pointage Desktop",
  "version": "0.1.0",
  "identifier": "cm.crfc.pointage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "CRFC Pointage Desktop",
        "width": 1440,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "CRFC",
    "copyright": "© 2026 CRFC. Tous droits réservés.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "CRFC Pointage Desktop"
  }
}
